#!/usr/bin/env bash
set -euo pipefail

if [ -z "${HOME:-}" ]; then
  printf 'HOME is required to store the Bridge pairing state.\n' >&2
  exit 1
fi

export PATH="/opt/homebrew/bin:/usr/local/bin:${HOME:-}/.local/bin:${PATH:-/usr/bin:/bin}"

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -h "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" >/dev/null 2>&1 && pwd)"
  SOURCE_LINK="$(readlink "$SOURCE_PATH")"
  if [[ "$SOURCE_LINK" = /* ]]; then SOURCE_PATH="$SOURCE_LINK"; else SOURCE_PATH="$SOURCE_DIR/$SOURCE_LINK"; fi
done
BRIDGE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" >/dev/null 2>&1 && pwd)"

if [ "$(uname -s)" = "Darwin" ]; then
  DEFAULT_STATE_DIR="${HOME}/Library/Application Support/Lumen Paper/Bridge/state"
else
  DEFAULT_STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/lumen-paper"
fi

export LUMEN_BRIDGE_STATE_DIR="${LUMEN_BRIDGE_STATE_DIR:-$DEFAULT_STATE_DIR}"
export LUMEN_BRIDGE_HOST="${LUMEN_BRIDGE_HOST:-127.0.0.1}"
export LUMEN_BRIDGE_PORT="${LUMEN_BRIDGE_PORT:-43177}"
export LUMEN_EXTENSION_ID="${LUMEN_EXTENSION_ID:-plekdghigijomceniepcgmfjpekcnkjf}"

TOKEN_PATH="$LUMEN_BRIDGE_STATE_DIR/.token"
NODE_BIN="${LUMEN_NODE_BIN:-$(command -v node || true)}"
CODEX_BIN="${LUMEN_CODEX_BIN:-$(command -v codex || true)}"
BRIDGE_VERSION="$(sed -n 's/^export const BRIDGE_VERSION = "\(.*\)";$/\1/p' "$BRIDGE_DIR/version.mjs")"
BRIDGE_PROTOCOL_VERSION="$(sed -n 's/^export const BRIDGE_PROTOCOL_VERSION = \([0-9][0-9]*\);$/\1/p' "$BRIDGE_DIR/version.mjs")"

usage() {
  cat <<'EOF'
Lumen Paper Codex Bridge

Usage:
  lumen-paper-bridge [start]                  Start the read-only Reader Bridge
  lumen-paper-bridge agent --workspace PATH   Allow workspace-write Agent mode
  lumen-paper-bridge full --workspace PATH    Explicitly unlock Full Agent mode
  lumen-paper-bridge status                   Check the local Bridge
  lumen-paper-bridge pair                     Copy the pairing token on macOS
  lumen-paper-bridge token                    Print the pairing token
  lumen-paper-bridge doctor                   Check Node, Codex and login state

The default Reader mode stays in the foreground. Press Ctrl-C to stop it.
EOF
}

check_node() {
  if [ -z "$NODE_BIN" ]; then
    printf 'Node.js 22+ was not found. Install Node, then run this command again.\n' >&2
    return 1
  fi
  NODE_MAJOR="$($NODE_BIN -p 'Number(process.versions.node.split(".")[0])')"
  if [ "$NODE_MAJOR" -lt 22 ]; then
    printf 'Node.js 22+ is required; found %s.\n' "$($NODE_BIN --version)" >&2
    return 1
  fi
}

check_codex() {
  if [ -z "$CODEX_BIN" ]; then
    printf 'Codex CLI was not found. Install Codex and sign in before starting the Bridge.\n' >&2
    return 1
  fi
  if ! "$CODEX_BIN" login status >/dev/null 2>&1; then
    printf 'Codex is not signed in. Run `codex login`, then start the Bridge again.\n' >&2
    return 1
  fi
  export LUMEN_CODEX_BIN="$CODEX_BIN"
}

token_value() {
  if [ -n "${LUMEN_BRIDGE_TOKEN:-}" ]; then
    printf '%s' "$LUMEN_BRIDGE_TOKEN" | tr -d '\r\n'
    return 0
  fi
  if [ ! -f "$TOKEN_PATH" ]; then
    check_node
    "$NODE_BIN" "$BRIDGE_DIR/server.mjs" --print-token >/dev/null
  fi
  tr -d '\r\n' < "$TOKEN_PATH"
}

health() {
  command -v curl >/dev/null 2>&1 || return 1
  HEALTH_HOST="$LUMEN_BRIDGE_HOST"
  if [ "$HEALTH_HOST" = "::1" ]; then HEALTH_HOST="[::1]"; fi
  curl --noproxy '*' --connect-timeout 1 --max-time 2 --proto '=http' -fsS \
    -H "Origin: chrome-extension://${LUMEN_EXTENSION_ID}" \
    -H "X-Lumen-Token: $(token_value)" \
    "http://${HEALTH_HOST}:${LUMEN_BRIDGE_PORT}/health"
}

show_token() {
  token_value
  printf '\n'
}

pair_token() {
  if command -v pbcopy >/dev/null 2>&1; then
    token_value | pbcopy
    printf 'Pairing token copied. Paste it into Lumen settings.\n'
  else
    printf 'Pairing token (paste into Lumen settings):\n\n'
    show_token
  fi
}

workspace_from_args() {
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "--workspace" ]; then
      if [ "$#" -lt 2 ] || [ ! -d "$2" ]; then
        printf 'Agent and Full Agent require --workspace with an existing directory.\n' >&2
        return 1
      fi
      (cd -P "$2" >/dev/null 2>&1 && pwd)
      return 0
    fi
    shift
  done
  printf 'Agent and Full Agent require --workspace /absolute/path.\n' >&2
  return 1
}

health_matches() {
  "$NODE_BIN" -e '
    const [raw, mode, workspace, version, protocol] = process.argv.slice(1);
    const health = JSON.parse(raw);
    const capabilities = health.capabilities || {};
    const versionMatches = health.version === version && health.protocolVersion === Number(protocol);
    const modeMatches = (mode === "reader" && capabilities.agent === false && capabilities.unrestricted === false)
      || (mode === "agent" && capabilities.agent === true && capabilities.unrestricted === false)
      || (mode === "full" && capabilities.unrestricted === true);
    const workspaceMatches = mode === "reader" || capabilities.workspace === workspace;
    process.exit(versionMatches && modeMatches && workspaceMatches ? 0 : 1);
  ' "$1" "$2" "$3" "$BRIDGE_VERSION" "$BRIDGE_PROTOCOL_VERSION"
}

start_bridge() {
  EXPECTED_MODE="$1"
  EXPECTED_WORKSPACE="$2"
  shift 2
  check_node
  check_codex
  if HEALTH_OUTPUT="$(health 2>/dev/null)"; then
    if health_matches "$HEALTH_OUTPUT" "$EXPECTED_MODE" "$EXPECTED_WORKSPACE"; then
      printf 'Lumen Bridge is already running at http://%s:%s with the requested profile.\n' "$LUMEN_BRIDGE_HOST" "$LUMEN_BRIDGE_PORT"
      printf '%s\n' "$HEALTH_OUTPUT"
      pair_token
      return 0
    fi
    printf 'A Bridge is already running, but its version, profile or workspace does not match this command.\n' >&2
    printf 'Stop the existing Bridge with Ctrl-C, then run this command again.\n' >&2
    printf 'Current Bridge: %s\n' "$HEALTH_OUTPUT" >&2
    return 3
  fi
  pair_token
  export LUMEN_BRIDGE_PRINT_TOKEN=0
  exec "$NODE_BIN" "$BRIDGE_DIR/server.mjs" "$@"
}

COMMAND="${1:-start}"
if [ "$#" -gt 0 ]; then shift; fi

case "$COMMAND" in
  start|reader)
    start_bridge reader "" "$@"
    ;;
  agent)
    REQUESTED_WORKSPACE="$(workspace_from_args "$@")"
    start_bridge agent "$REQUESTED_WORKSPACE" --allow-agent "$@"
    ;;
  full)
    printf 'Warning: Full Agent disables the Codex sandbox and approval prompts.\n' >&2
    REQUESTED_WORKSPACE="$(workspace_from_args "$@")"
    start_bridge full "$REQUESTED_WORKSPACE" --allow-agent --allow-unrestricted "$@"
    ;;
  status)
    if ! health; then
      printf 'Lumen Bridge is not reachable at http://%s:%s.\n' "$LUMEN_BRIDGE_HOST" "$LUMEN_BRIDGE_PORT" >&2
      exit 1
    fi
    printf '\n'
    ;;
  pair)
    pair_token
    ;;
  token)
    show_token
    ;;
  doctor)
    printf 'Bridge files: %s\n' "$BRIDGE_DIR"
    printf 'State:        %s\n' "$LUMEN_BRIDGE_STATE_DIR"
    check_node && printf 'Node:         %s\n' "$($NODE_BIN --version)"
    if [ -n "$CODEX_BIN" ]; then
      printf 'Codex:        %s\n' "$($CODEX_BIN --version 2>&1 | head -n 1)"
      "$CODEX_BIN" login status || true
    else
      printf 'Codex:        not found\n'
      exit 1
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
